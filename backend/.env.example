# AttendX Database Configuration
# Default is SQLite (zero setup required)
USE_MYSQL=False

# If you want to connect to your local MySQL80 service:
# 1. Set USE_MYSQL=True
# 2. Enter your MySQL root password below
# 3. Create the database in MySQL: CREATE DATABASE attendx_db;
# 4. Run: python manage.py migrate && python manage.py seed_data

DB_NAME=attendx_db
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306
